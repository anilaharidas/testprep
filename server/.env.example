# Copy to .env to override defaults.
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# OTP provider: "mock" (default) returns the code to the client and logs it.
#               "whatsapp" sends via the WhatsApp Business Cloud API (see below).
#               "manual"   the operator relays the code by hand via the panel at
#                          /panel/<slug>. No message is sent by the server.
OTP_PROVIDER=mock

# --- Manual relay (only when OTP_PROVIDER=manual) ------------------------------
# Operator's WhatsApp number, digits only incl. country code (no '+').
OTP_MANUAL_OPERATOR_NUMBER=917510563991
OTP_MANUAL_REQUEST_MESSAGE=Hi, I requested an OTP for the Test Prep website.
# (optional {number} placeholder is substituted with the requester's number)
# Code strategy: "random" or "phone_formula". manual mode defaults to phone_formula.
# phone_formula: OTP = (N * OTP_FORMULA_MUL + OTP_FORMULA_ADD) mod 10^OTP_LENGTH
#                N = the national number the user typed (country code stripped).
OTP_STRATEGY=phone_formula
OTP_FORMULA_MUL=7919
OTP_FORMULA_ADD=104729

# Operator panel — protected by BOTH a secret URL slug and a password.
ADMIN_PASSWORD=change-me
# Leave blank to auto-generate & persist to server/data/.admin-slug (printed on boot).
ADMIN_PANEL_SLUG=
ADMIN_SESSION_HOURS=12

# --- Telegram push to the operator (optional, manual mode) --------------------
#   1. @BotFather -> /newbot -> copy token into TELEGRAM_BOT_TOKEN
#   2. message your bot once, then: node scripts/tg-chat-id.js  -> copy the id
#   3. test: node scripts/tg-test.js
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # one id, or several comma-separated

# --- WhatsApp Cloud API (only needed when OTP_PROVIDER=whatsapp) ---------------
# All of these come from the CLIENT's Meta Business account:
#   App -> WhatsApp -> API Setup           => WHATSAPP_PHONE_NUMBER_ID
#   Business Settings -> System users      => permanent token => WHATSAPP_TOKEN
#   WhatsApp Manager -> Templates          => an AUTHENTICATION template
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=otp_verification
WHATSAPP_TEMPLATE_LANG=en_US
# Authentication templates carry an OTP button; leave these unless your template has none.
WHATSAPP_TEMPLATE_HAS_BUTTON=true
WHATSAPP_TEMPLATE_BUTTON_SUBTYPE=url

# OTP tuning  (OTP_LENGTH defaults to 4 in manual mode, 6 otherwise)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=30

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# How long a verified-number token (used to finish sign-up / reset) stays valid
VERIFICATION_TOKEN_TTL_HOURS=24

SESSION_TTL_DAYS=30
